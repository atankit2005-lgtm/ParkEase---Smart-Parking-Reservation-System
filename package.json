{
  "name": "parkease",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ParkEase 2.0 - Smart Parking Reservation System (MERN)",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:db": "npm run test:db --workspace @parkease/api",
    "test:e2e": "playwright test",
    "infra:start": "node scripts/mongo-replica-set.mjs start",
    "infra:stop": "node scripts/mongo-replica-set.mjs stop",
    "infra:status": "node scripts/mongo-replica-set.mjs status"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
