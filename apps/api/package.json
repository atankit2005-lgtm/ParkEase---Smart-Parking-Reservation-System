{
  "name": "@parkease/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ParkEase API (Express 5 shell, Stage 02)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:db": "vitest run tests/db"
  },
  "dependencies": {
    "@parkease/contracts": "0.0.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "mongodb": "7.7.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
